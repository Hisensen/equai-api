# Public service
H3_ADMIN_PASSWORD=replace-with-a-long-random-password
H3_DOWNLOAD_SECRET=replace-with-at-least-32-random-characters
H3_SETTINGS_SECRET=replace-with-at-least-32-random-characters
H3_PUBLIC_BASE_URL=https://equai.vip
H3_COOKIE_SECURE=1
CORS_ORIGINS=https://equai.vip,https://www.equai.vip

# Private data and retention
H3_DATA_DIR=/data
H3_LOCAL_OUTPUTS=0
H3_LOCAL_OUTPUT_DIR=/data/videos
H3_LOCAL_INPUT_DIR=/data/inputs
H3_LOCAL_RESULT_DIR=/data/job-results
H3_WORKER_TRANSFER_BACKEND=cos
H3_TRANSFER_BASE_URL=https://equai.vip
# Optional direct origin for ASR file downloads when a CDN blocks the provider.
H3_ASR_FILE_URL_BASE=
H3_TRANSFER_HOSTNAME=
H3_TRANSFER_HOST_IP=
H3_TRANSFER_SECRET=replace-with-at-least-32-random-characters
H3_TRANSFER_MAX_GRANT_SECONDS=93600
H3_DIRECT_UPLOADS=0
H3_INPUT_RETENTION_SECONDS=86400
H3_OUTPUT_RETENTION_SECONDS=172800
H3_MIN_FREE_OUTPUT_BYTES=2147483648
H3_MAX_CONCURRENCY=20

# Hidden prompt middleware. URL, enabled state, and encrypted API Key are managed in /admin.
H3_PROMPT_DEFAULT_BASE_URL=https://api.deepseek.com
H3_PROMPT_MODEL=deepseek-v4-flash

# Tencent COS is retained only for encrypted database backups and rollback.
COS_REGION=replace-me
COS_BUCKET=replace-me
COS_SECRET_ID=replace-me
COS_SECRET_KEY=replace-me
COS_INPUT_PREFIX=inputs
COS_OUTPUT_PREFIX=outputs
COS_PRESIGN_SECONDS=3600
# Optional private CDN/custom COS domain (hostname only). When absent, signed
# downloads use the native COS endpoint.
COS_CDN_DOMAIN=

# Gongji scheduler
GONGJI_TOKEN=replace-me
GONGJI_REPO_USERNAME=replace-me
GONGJI_REPO_PASSWORD=replace-me
GONGJI_STORAGE_ID=replace-me
GONGJI_720_IMAGE=replace-me
GONGJI_720_STORAGE_ID=replace-me
GONGJI_720_REGION_NAME=replace-me
GONGJI_720_GPU_NAME=4090
GONGJI_720_GPU_COUNT=1
GONGJI_1080_IMAGE=replace-me
GONGJI_1080_STORAGE_ID=replace-me
GONGJI_1080_REGION_NAME=replace-me
GONGJI_1080_GPU_NAME=5090
GONGJI_1080_GPU_COUNT=1
GONGJI_2K_IMAGE=replace-me
GONGJI_2K_STORAGE_ID=replace-me
GONGJI_2K_REGION_NAME=天津一区
GONGJI_2K_GPU_NAME=5090
GONGJI_2K_GPU_COUNT=1
GONGJI_2K_ESTIMATED_SEC=960
GONGJI_2K_TIMEOUT_SEC=3600

# Optional Tianjin 5090 fallbacks. Zhejiang 4090 stays primary for video and
# commerce; each route checks live inventory and uses Tianjin only when empty.
GONGJI_720_BACKUP_REGION_NAME=天津一区
GONGJI_720_BACKUP_GPU_NAME=5090
GONGJI_720_BACKUP_GPU_COUNT=1
GONGJI_720_BACKUP_CPU_CORES=16
GONGJI_720_BACKUP_STORAGE_ID=2593
GONGJI_720_BACKUP_IMAGE=harborpush.suanleme.cn/h3platform/h3-video-worker:standard-v9-r50-5090-2k-ref1-6step-denoise02-baked-runtime-20261014-v12
GONGJI_REMIX_720_BACKUP_REGION_NAME=天津一区
GONGJI_REMIX_720_BACKUP_GPU_NAME=5090
GONGJI_REMIX_720_BACKUP_GPU_COUNT=1
GONGJI_REMIX_720_BACKUP_CPU_CORES=16
GONGJI_REMIX_720_BACKUP_STORAGE_ID=2593
GONGJI_REMIX_720_BACKUP_IMAGE=harborpush.suanleme.cn/h3platform/h3-video-worker:standard-v9-r50-5090-2k-ref1-6step-denoise02-baked-runtime-20261014-v12
GONGJI_1080_BACKUP_REGION_NAME=天津一区
GONGJI_1080_BACKUP_GPU_NAME=5090
GONGJI_1080_BACKUP_GPU_COUNT=1
GONGJI_1080_BACKUP_CPU_CORES=16
GONGJI_1080_BACKUP_STORAGE_ID=2593
GONGJI_1080_BACKUP_IMAGE=harborpush.suanleme.cn/h3platform/h3-video-worker:standard-v9-r50-5090-2k-ref1-6step-denoise02-baked-runtime-20261014-v12
GONGJI_REMIX_1080_BACKUP_REGION_NAME=天津一区
GONGJI_REMIX_1080_BACKUP_GPU_NAME=5090
GONGJI_REMIX_1080_BACKUP_GPU_COUNT=1
GONGJI_REMIX_1080_BACKUP_CPU_CORES=16
GONGJI_REMIX_1080_BACKUP_STORAGE_ID=2593
GONGJI_REMIX_1080_BACKUP_IMAGE=harborpush.suanleme.cn/h3platform/h3-video-worker:standard-v9-r50-5090-2k-ref1-6step-denoise02-baked-runtime-20261014-v12
GONGJI_2K_BACKUP_REGION_NAME=天津一区
GONGJI_2K_BACKUP_GPU_NAME=5090
GONGJI_2K_BACKUP_GPU_COUNT=1
GONGJI_2K_BACKUP_CPU_CORES=16
GONGJI_2K_BACKUP_STORAGE_ID=2593
GONGJI_2K_BACKUP_IMAGE=harborpush.suanleme.cn/h3platform/h3-video-worker:standard-v9-r50-5090-2k-ref1-6step-denoise02-baked-runtime-20261014-v12
GONGJI_REMIX_2K_BACKUP_REGION_NAME=天津一区
GONGJI_REMIX_2K_BACKUP_GPU_NAME=5090
GONGJI_REMIX_2K_BACKUP_GPU_COUNT=1
GONGJI_REMIX_2K_BACKUP_CPU_CORES=16
GONGJI_REMIX_2K_BACKUP_STORAGE_ID=2593
GONGJI_REMIX_2K_BACKUP_IMAGE=harborpush.suanleme.cn/h3platform/h3-video-worker:standard-v9-r50-5090-2k-ref1-6step-denoise02-baked-runtime-20261014-v12

# Merchant prices are expressed in milli-pt (1000 = 1 pt).
H3_PRICE_720P_MILLI=1000
H3_PRICE_1080P_MILLI=2000
H3_PRICE_2K_MILLI=3000

# IndexTTS-2 is isolated from H3 video. Confirm the applicable model license
# terms, preload the model, and run a real GPU smoke test before enabling.
H3_VOICE_CLONE_ENABLED=0
H3_VOICE_CLONE_PRICE_MILLI=0
H3_VOICE_CLONE_MAX_CONCURRENCY=1
GONGJI_VOICE_CLONE_IMAGE=
GONGJI_VOICE_CLONE_STORAGE_ID=
GONGJI_VOICE_CLONE_REGION_NAME=浙江四区
GONGJI_VOICE_CLONE_GPU_NAME=4090
