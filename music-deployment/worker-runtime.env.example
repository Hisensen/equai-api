# Copy to the worker host as worker-runtime.env. Keep secrets out of this file.
# The worker reads credentials from the host secret manager or injected env.
MUSIC_MODEL_RELEASE=2026-09-29-yue2-sheetsage2
MUSIC_MODEL_MANIFEST_KEY=models/h3-standard/music/2026-09-29-yue2-sheetsage2/manifest.json
MUSIC_MODEL_CURRENT_KEY=models/h3-standard/music/current.json
MUSIC_MODEL_CACHE_DIR=/var/lib/equai/music-models
MUSIC_JOB_DIR=/var/lib/equai/music-jobs
MUSIC_QUEUE_CONCURRENCY=1
# Deliberately disabled until the owner starts the prewarm step.
MUSIC_PREWARM=0
